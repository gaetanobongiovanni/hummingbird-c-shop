{**
 * C-Shop homepage — advantages for business customers.
 * Lists only features actually provided by this theme / PrestaShop core.
 *}
<section class="cs-section" aria-labelledby="cs-home-b2b-title">
  <div class="container">
    <div class="cs-panel">
      <div class="cs-section__header">
        <h2 id="cs-home-b2b-title" class="cs-section__title">{l s='For businesses and public bodies' d='Shop.Theme.Cshop'}</h2>
      </div>

      <ul class="cs-benefits">
        <li class="cs-benefits__item">
          <span class="material-icons cs-benefits__icon" aria-hidden="true">&#xE8B6;</span>
          <span class="cs-benefits__title">{l s='Search by code' d='Shop.Theme.Cshop'}</span>
          <span class="cs-benefits__text">{l s='Product code, supplier code, OEM code and brand.' d='Shop.Theme.Cshop'}</span>
        </li>
        <li class="cs-benefits__item">
          <span class="material-icons cs-benefits__icon" aria-hidden="true">&#xE863;</span>
          <span class="cs-benefits__title">{l s='Quick reorder' d='Shop.Theme.Cshop'}</span>
          <span class="cs-benefits__text">{l s='Reorder from your order history in one click.' d='Shop.Theme.Cshop'}</span>
        </li>
        <li class="cs-benefits__item">
          <span class="material-icons cs-benefits__icon" aria-hidden="true">&#xE8F1;</span>
          <span class="cs-benefits__title">{l s='Packs and minimums always visible' d='Shop.Theme.Cshop'}</span>
          <span class="cs-benefits__text">{l s='Pack quantity, minimum order and unit price on every product.' d='Shop.Theme.Cshop'}</span>
        </li>
        <li class="cs-benefits__item">
          <span class="material-icons cs-benefits__icon" aria-hidden="true">&#xE0AF;</span>
          <span class="cs-benefits__title">{l s='Company account' d='Shop.Theme.Cshop'}</span>
          <span class="cs-benefits__text">{l s='Register with your company details and manage your addresses.' d='Shop.Theme.Cshop'}</span>
        </li>
      </ul>
    </div>
  </div>
</section>
